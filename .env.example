# Neon Postgres connection string (pooled). Get it from https://neon.tech
# → your project → Connect → copy the `postgres://...` URL.
# Example: postgres://user:password@ep-xyz-123.ap-southeast-1.aws.neon.tech/fintrack?sslmode=require
DATABASE_URL=postgres://USER:PASSWORD@EP-HOST.neon.tech/DBNAME?sslmode=require

# Local dev (optional)
PORT=3000
